FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/ckk_snapshot

WORKDIR /app
COPY requirements-sovereign.txt ./
RUN pip install --no-cache-dir -r requirements-sovereign.txt
COPY ckk_snapshot/ckk/sovereign ./ckk_snapshot/ckk/sovereign
COPY ckk_snapshot/ckk/observatory ./ckk_snapshot/ckk/observatory
COPY ckk_snapshot/ckk/causal_lab ./ckk_snapshot/ckk/causal_lab
RUN mkdir -p /causal-observatory \
    && useradd --system --uid 10002 causal-lab \
    && chown -R causal-lab:causal-lab /causal-observatory

USER causal-lab
CMD ["python", "-m", "ckk.causal_lab.cli"]
