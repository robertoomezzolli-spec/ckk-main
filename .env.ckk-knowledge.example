# Generate a random value of at least 32 characters. Never commit the real token.
CKK_ADAPTER_TOKEN=replace-with-random-internal-token

# The experiment repository and scientific baseline are public identifiers,
# pinned in docker-compose and the hashed execution manifest. They are shown
# here only for operators who run the adapter outside Compose.
CKK_EXPERIMENT_ENABLED=true
CKK_EXPERIMENT_REPOSITORY_URL=https://github.com/robertoomezzolli-spec/ckk-main.git
CKK_EXPERIMENT_BRANCH=experiment/solar-system-provenance-cascade
CKK_EXPERIMENT_TARGET_COMMIT=5faf926d6cc324e08c32649e1b92cf57f3c56cb3
