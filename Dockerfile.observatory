FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/ckk_snapshot \
    OBSERVATORY_STATE_DIR=/observatory

WORKDIR /app
COPY requirements-observatory.txt ./
RUN pip install --no-cache-dir -r requirements-observatory.txt
COPY ckk_snapshot/ckk/observatory ./ckk_snapshot/ckk/observatory
RUN mkdir -p /observatory && useradd --system --uid 10002 observatory && chown -R observatory:observatory /observatory

USER observatory
EXPOSE 8090
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8090/healthz', timeout=3)"
CMD ["uvicorn", "ckk.observatory.asgi:app", "--host", "0.0.0.0", "--port", "8090", "--workers", "1"]
