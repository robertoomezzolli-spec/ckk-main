# Observatory-only operator credentials. Never pass these to the organism.
OBSERVATORY_OPERATOR_USER=operator
OBSERVATORY_OPERATOR_PASSWORD=choose_a_long_random_value
OBSERVATORY_STATE_DIR=/observatory
OBSERVATORY_SANDBOX_PROBES_ENABLED=true
OBSERVATORY_BOOTSTRAP_CONTROL_PAIR=true
OBSERVATORY_PROBE_MIN_SECONDS=3600
OBSERVATORY_PROBE_MAX_SECONDS=14400
KAIROS_SUBJECT_VERSION=replace_me
